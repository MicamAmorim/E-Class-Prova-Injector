{
  "manifest_version": 3,
  "name": "E-Class Prova Injector",
  "version": "0.3.0",
  "description": "Importa provas em LaTeX ou Word, incluindo questões abertas e imagens, e exporta gabarito/turmas para o corretor OMR.",
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "activeTab",
    "sidePanel",
    "webRequest"
  ],
  "host_permissions": [
    "https://portal.educacaoadventista.org.br/*",
    "https://api-avaliacoes.educacaoadventista.org.br/*",
    "https://api-usuario.educacaoadventista.org.br/*",
    "https://ti5v892yac.execute-api.sa-east-1.amazonaws.com/*",
    "https://snv.educacaoadventista.org.br/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "E-Class Prova Injector",
    "default_popup": "launcher.html"
  },
  "side_panel": {
    "default_path": "panel.html"
  }
}
